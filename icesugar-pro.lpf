# IceSugar-Pro (LFE5U-25F-6BG256C) — synth pinout
# Clock 25 MHz. UART via on-module iCELink. RGB LED active-high.
# I2S: P4 HDMI-end outer row.
# https://github.com/wuxx/icesugar-pro/blob/master/doc/iCESugar-pro-pinmap.png

LOCATE COMP "CLK" SITE "P6";
IOBUF  PORT "CLK" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
FREQUENCY PORT "CLK" 25 MHZ;

LOCATE COMP "RX" SITE "A9";
IOBUF  PORT "RX" PULLMODE=UP IO_TYPE=LVCMOS33 DRIVE=4;

LOCATE COMP "TX" SITE "B9";
IOBUF  PORT "TX" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;

LOCATE COMP "led_r" SITE "B11";
IOBUF  PORT "led_r" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;

LOCATE COMP "led_g" SITE "A11";
IOBUF  PORT "led_g" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;

LOCATE COMP "led_b" SITE "A12";
IOBUF  PORT "led_b" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;

# P4 hole 6 / I2S2 pin 1 MCLK
LOCATE COMP "PMOD1" SITE "E4";
IOBUF  PORT "PMOD1" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;

# P4 hole 5 / I2S2 pin 2 LRCK
LOCATE COMP "PMOD2" SITE "D4";
IOBUF  PORT "PMOD2" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;

# P4 hole 4 / I2S2 pin 3 SCLK
LOCATE COMP "PMOD3" SITE "D5";
IOBUF  PORT "PMOD3" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;

# P4 hole 3 / I2S2 pin 4 SDATA
LOCATE COMP "PMOD4" SITE "R7";
IOBUF  PORT "PMOD4" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=4;
